# Server-only Vercel environment variables. Copy to ignored .env.local for dev.
# Both OAuth clients must belong to the same Google Cloud depositly project.
GOOGLE_CLIENT_ID=688859064258-h97snetju0b3rts3jltgd210dobn75f1.apps.googleusercontent.com
# Get the secret for the Web OAuth client from Google Cloud; never commit it.
GOOGLE_CLIENT_SECRET=
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Use http://localhost:4173 in .env.local; production requires HTTPS.
APP_ORIGIN=https://depositly.vercel.app
