      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;border-radius:10px;font-family:var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif);font-size:13px;line-height:1.6;font-weight:650;cursor:pointer;transition:background-color 180ms cubic-bezier(.2,.8,.2,1),color 180ms cubic-bezier(.2,.8,.2,1),border-color 180ms cubic-bezier(.2,.8,.2,1);background:var(--action,#f5e211);color:#2c2e2a;border:1px solid transparent}.ds-primary:hover{background:var(--action-hover,#e4d10d)}.ds-primary:focus-visible{outline:3px solid var(--green,#37552a);outline-offset:4px}.ds-primary:active{transform:translateY(1px)}.ds-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Surface-colored action for non-primary choices.",
      "html": "<button type=\"button\" class=\"ds-secondary\">Download backup</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 18px;border-radius:10px;font-family:var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif);font-size:13px;line-height:1.6;font-weight:650;cursor:pointer;transition:background-color 180ms cubic-bezier(.2,.8,.2,1),color 180ms cubic-bezier(.2,.8,.2,1),border-color 180ms cubic-bezier(.2,.8,.2,1);background:var(--surface,#fcfbf5);color:var(--ink,#2c2e2a);border:1px solid var(--line,#d5d9c7)}.ds-secondary:hover{background:var(--soft,#e9eddb)}.ds-secondary:focus-visible{outline:3px solid var(--green,#37552a);outline-offset:4px}.ds-secondary:active{transform:translateY(1px)}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Labeled input",
      "kind": "input",
      "refersTo": "input",
      "description": "A standard field with muted label and a clear green focus state.",
      "html": "<label class=\"ds-field\" for=\"ds-deposit-name\">Deposit name<input id=\"ds-deposit-name\" type=\"text\" placeholder=\"e.g. Emergency fund\"></label>",
      "css": ".ds-field{display:block;max-width:330px;color:var(--muted,#5d6255);font-family:var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif);font-size:12px;font-weight:600;line-height:1.6}.ds-field input{display:block;width:100%;margin-top:7px;min-height:44px;padding:11px 12px;border:1px solid var(--line,#d5d9c7);border-radius:9px;background:var(--surface,#fcfbf5);color:var(--ink,#2c2e2a);font-family:var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif);font-size:13px;caret-color:var(--green,#37552a);transition:border-color 180ms cubic-bezier(.2,.8,.2,1)}.ds-field input::placeholder{color:var(--muted,#5d6255);opacity:1}.ds-field input:focus{border-color:var(--green,#37552a);outline:2px solid var(--green,#37552a);outline-offset:2px}.ds-field input:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-field input{transition:none}}"
    },
    {
      "name": "Current navigation",
      "kind": "nav",
      "refersTo": "nav-current",
      "description": "Text destinations with a yellow current state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><button class=\"ds-nav-current\" type=\"button\" aria-current=\"page\">Dashboard</button><button type=\"button\">My deposits</button><button type=\"button\">Payments</button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:3px;flex-wrap:wrap;font-family:var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif)}.ds-nav button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 12px;border:0;border-radius:9px;background:transparent;color:var(--muted,#5d6255);font:600 12px/1.6 var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif);white-space:nowrap;cursor:pointer;transition:background-color 180ms cubic-bezier(.2,.8,.2,1),color 180ms cubic-bezier(.2,.8,.2,1)}.ds-nav .ds-nav-current{background:var(--action,#f5e211);color:#2c2e2a}.ds-nav button:hover:not(.ds-nav-current){background:var(--soft,#e9eddb);color:var(--ink,#2c2e2a)}.ds-nav button:focus-visible{outline:3px solid var(--green,#37552a);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-nav button{transition:none}}"
    },
    {
      "name": "Received status",
      "kind": "chip",
      "refersTo": "chip-received",
      "description": "A passive text-bearing status chip; color reinforces the label.",
      "html": "<span class=\"ds-status\"><span class=\"ds-status-dot\" aria-hidden=\"true\"></span>Received</span>",
      "css": ".ds-status{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border-radius:6px;background:var(--positive-soft,#e0edcf);color:var(--positive,#3e612c);font-family:var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif);font-size:11px;line-height:1.6;white-space:nowrap}.ds-status-dot{display:inline-block;width:5px;height:5px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Work card",
      "kind": "card",
      "refersTo": "card",
      "description": "A flat contained surface for settings, backup details, or supporting records.",
      "html": "<section class=\"ds-card\" aria-labelledby=\"ds-card-title\"><h2 id=\"ds-card-title\">Your workspace</h2><p>Manage your deposits and preferences.</p></section>",
      "css": ".ds-card{max-width:420px;padding:26px;border:1px solid var(--line,#d5d9c7);border-radius:14px;background:var(--surface,#fcfbf5);color:var(--ink,#2c2e2a);font-family:var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif);box-shadow:none}.ds-card h2{margin:0;font-size:19px;font-weight:650;line-height:1.6;letter-spacing:-.025em}.ds-card p{margin:5px 0 0;color:var(--muted,#5d6255);font-size:12px;line-height:1.8}@media(max-width:700px){.ds-card{padding:23px}}"
    },
    {
      "name": "Payment row",
      "kind": "custom",
      "description": "An open ruled payment record with a right-aligned amount.",
      "html": "<button type=\"button\" class=\"ds-payment\"><span class=\"ds-payment-date\"><small>OCT</small><b>25</b></span><span class=\"ds-payment-info\"><b>Sample deposit</b><small>Interest</small></span><span class=\"ds-payment-amount\"><b>৳1,500</b><small>After TDS</small></span></button>",
      "css": ".ds-payment{display:flex;align-items:center;gap:12px;width:100%;max-width:520px;min-height:75px;padding:15px 0;border:0;border-bottom:1px solid var(--line,#d5d9c7);border-radius:0;background:transparent;color:var(--ink,#2c2e2a);font-family:var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif);text-align:left;cursor:pointer;transition:background-color 180ms cubic-bezier(.2,.8,.2,1)}.ds-payment:hover{background:var(--soft,#e9eddb)}.ds-payment:focus-visible{outline:3px solid var(--green,#37552a);outline-offset:4px}.ds-payment-date{display:grid;align-content:center;width:42px;min-width:42px;height:45px;text-align:center}.ds-payment-date small{font-size:9px;line-height:1.6;color:var(--muted,#5d6255);font-weight:600;letter-spacing:.04em}.ds-payment-date b{font-size:21px;font-weight:650;line-height:1.2}.ds-payment-info{flex:1;min-width:0}.ds-payment-info b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;line-height:1.6;font-weight:650}.ds-payment-info small,.ds-payment-amount small{display:block;margin-top:4px;font-size:10px;line-height:1.6;color:var(--muted,#5d6255)}.ds-payment-amount{white-space:nowrap;text-align:right;font-variant-numeric:tabular-nums}.ds-payment-amount b{font-size:12px;font-weight:650;line-height:1.6}@media(min-width:1161px) and (max-height:800px){.ds-payment{min-height:61px;padding-top:8px;padding-bottom:8px}}@media(prefers-reduced-motion:reduce){.ds-payment{transition:none}}"
    },
    {
      "name": "Income field",
      "kind": "custom",
      "refersTo": "income-field",
      "description": "The signature apple-green financial region with proportional, keyboard-readable bars.",
      "html": "<section class=\"ds-income\" aria-labelledby=\"ds-income-title\"><div class=\"ds-income-top\"><h2 id=\"ds-income-title\">Income forecast</h2><span>Next 6 months · BDT</span></div><p class=\"ds-income-total\">৳12,000 <small>scheduled net interest</small></p><div class=\"ds-income-chart\" role=\"group\" aria-label=\"Illustrative scheduled net interest\"><button class=\"ds-income-month\" type=\"button\" aria-label=\"October: illustrative payment\" style=\"--bar-ratio:0.25;--i:0\"><span class=\"ds-income-bar\"><span class=\"ds-income-tip\">Illustrative amount</span></span><small>Oct</small></button><button class=\"ds-income-month\" type=\"button\" aria-label=\"November: illustrative payment\" style=\"--bar-ratio:0.8;--i:1\"><span class=\"ds-income-bar\"><span class=\"ds-income-tip\">Illustrative amount</span></span><small>Nov</small></button><button class=\"ds-income-month\" type=\"button\" aria-label=\"December: illustrative payment\" style=\"--bar-ratio:0.4;--i:2\"><span class=\"ds-income-bar\"><span class=\"ds-income-tip\">Illustrative amount</span></span><small>Dec</small></button><button class=\"ds-income-month\" type=\"button\" aria-label=\"January: illustrative payment\" style=\"--bar-ratio:0.6;--i:3\"><span class=\"ds-income-bar\"><span class=\"ds-income-tip\">Illustrative amount</span></span><small>Jan</small></button><button class=\"ds-income-month\" type=\"button\" aria-label=\"February: illustrative payment\" style=\"--bar-ratio:1;--i:4\"><span class=\"ds-income-bar\"><span class=\"ds-income-tip\">Illustrative amount</span></span><small>Feb</small></button><button class=\"ds-income-month\" type=\"button\" aria-label=\"March: illustrative payment\" style=\"--bar-ratio:0.5;--i:5\"><span class=\"ds-income-bar\"><span class=\"ds-income-tip\">Illustrative amount</span></span><small>Mar</small></button></div><p class=\"ds-income-note\">Select a month to view its payments. Estimates use your deposit terms and TDS.</p></section>",
      "css": ".ds-income{max-width:650px;padding:27px 30px 24px;border-radius:16px 16px 62px 16px;background:var(--field,#8ed462);color:var(--field-ink,#203a16);font-family:var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif)}.ds-income-top{display:flex;align-items:flex-start;justify-content:space-between;gap:15px}.ds-income-top h2{margin:0;font-size:20px;font-weight:700;line-height:1.6;letter-spacing:-.025em}.ds-income-top>span{padding:7px 10px;border:1px solid #34582355;border-radius:7px;color:#243f18;font-size:11px;line-height:1.5}.ds-income-total{display:flex;align-items:baseline;gap:13px;flex-wrap:wrap;margin:12px 0 0;font-size:34px;font-weight:650;line-height:1.3;letter-spacing:-.04em;font-variant-numeric:tabular-nums}.ds-income-total small{font-size:11px;font-weight:400;letter-spacing:0;color:#2d4b20}.ds-income-chart{--plot-height:150px;display:grid;grid-template-columns:repeat(6,1fr);gap:24px;height:202px;margin-top:16px;padding:20px 10px 0 33px}.ds-income-month{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;min-width:0;min-height:44px;padding:0;border:0;border-radius:4px;background:transparent;color:#203a16;font-family:var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif);cursor:pointer}.ds-income-bar{display:block;position:relative;width:100%;max-width:55px;height:max(2px,calc(var(--bar-ratio)*var(--plot-height)));border-radius:5px 5px 0 0;background:#365b25;transform-origin:bottom;animation:ds-field-bar 650ms cubic-bezier(.16,1,.3,1) both;animation-delay:calc(var(--i)*35ms);transition:background-color 180ms cubic-bezier(.2,.8,.2,1)}.ds-income-month:nth-child(even) .ds-income-bar{background:#243f18}.ds-income-month:hover .ds-income-bar,.ds-income-month:focus-visible .ds-income-bar{background:var(--action,#f5e211)}.ds-income-month:focus-visible{outline:3px solid #203a16;outline-offset:4px}.ds-income-month>small{margin-top:10px;font-size:11px;line-height:1.6}.ds-income-tip{position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);padding:6px 9px;border-radius:6px;background:#243f18;color:#fff;font-size:11px;line-height:1.6;white-space:nowrap;opacity:0;pointer-events:none;z-index:2;transition:opacity 150ms}.ds-income-month:hover .ds-income-tip,.ds-income-month:focus-visible .ds-income-tip{opacity:1}.ds-income-note{max-width:65ch;margin:20px 0 0;font-size:11px;line-height:1.8;color:#2d4b20}@keyframes ds-field-bar{from{transform:scaleY(.03)}to{transform:scaleY(1)}}@media(min-width:1161px) and (max-height:800px){.ds-income{padding-top:24px;padding-bottom:22px}.ds-income-chart{height:162px;--plot-height:114px;margin-top:12px}.ds-income-note{margin-top:16px}}@media(max-width:700px){.ds-income{padding:25px 23px 23px;border-bottom-right-radius:50px}.ds-income-chart{gap:22px}.ds-income-total{display:block;font-size:32px}.ds-income-total small{display:block;margin-top:3px;font-size:10px}.ds-income-top>span{max-width:112px;font-size:10px;text-align:center}.ds-income-note{font-size:10px}}@media(prefers-reduced-motion:reduce){.ds-income-bar,.ds-income-tip{animation:none;transition:none}}"
    },
    {
      "name": "Account identity",
      "kind": "button",
      "description": "Compact account control with a circular initials fallback, account name, and connection text.",
      "html": "<button type=\"button\" class=\"ds-account\"><span class=\"ds-account-avatar\" aria-hidden=\"true\">AN</span><span class=\"ds-account-info\"><b>Account name</b><span><i aria-hidden=\"true\"></i>Google connected</span></span></button>",
      "css": ".ds-account{display:inline-flex;align-items:center;justify-content:flex-start;gap:9px;max-width:230px;min-height:46px;padding:6px 10px 6px 7px;border:1px solid var(--line,#d5d9c7);border-radius:10px;background:var(--surface,#fcfbf5);color:var(--ink,#2c2e2a);font-family:var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif);text-align:left;cursor:pointer;transition:background-color 180ms cubic-bezier(.2,.8,.2,1)}.ds-account:hover{background:var(--soft,#e9eddb)}.ds-account:focus-visible{outline:3px solid var(--green,#37552a);outline-offset:4px}.ds-account:active{transform:translateY(1px)}.ds-account-avatar{display:inline-grid;place-items:center;flex:0 0 34px;width:34px;height:34px;border:1px solid var(--line,#d5d9c7);border-radius:50%;overflow:hidden;background:var(--soft,#e9eddb);color:var(--green,#37552a);font-size:11.56px;font-weight:650;line-height:1}.ds-account-info{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:3px;min-width:0}.ds-account-info b{display:block;max-width:185px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:12px;font-weight:600;line-height:1.4}.ds-account-info>span{display:inline-flex;align-items:center;gap:5px;color:var(--green,#37552a);font-size:10px;font-weight:500;line-height:1.4;white-space:nowrap}.ds-account-info i{display:inline-block;flex:0 0 5px;width:5px;height:5px;border-radius:50%;background:currentColor}@media(prefers-reduced-motion:reduce){.ds-account{transition:none}}"
    },
    {
      "name": "Legal contents",
      "kind": "nav",
      "description": "Long-form reading navigation with a simple yellow hover state.",
      "html": "<nav class=\"ds-contents\" aria-label=\"Page contents\"><p>On this page</p><a href=\"#about\">About this policy</a><a href=\"#storage\">Storage on your phone and browser</a><a href=\"#choices\">Your choices and deletion</a><a class=\"ds-contents-crosslink\" href=\"/terms/\">Terms of service<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14m-5-5 5 5-5 5\"/></svg></a></nav>",
      "css": ".ds-contents{max-width:250px;font-family:var(--font-ui,Manrope,'Nirmala UI',system-ui,sans-serif)}.ds-contents p{margin:0 0 16px 12px;color:var(--ink,#2c2e2a);font-size:14px;font-weight:750;line-height:1.7}.ds-contents a{display:flex;align-items:center;min-height:44px;padding:9px 12px;border-radius:6px;color:var(--copy,#474b40);text-decoration:none;font-size:13px;font-weight:550;line-height:1.6;transition:color 180ms ease,background-color 180ms ease}.ds-contents a:hover{background:var(--yellow,#f5e211);color:var(--ink,#2c2e2a)}.ds-contents a:focus-visible{outline:3px solid var(--ink,#2c2e2a);outline-offset:4px}.ds-contents .ds-contents-crosslink{display:inline-flex;gap:8px;margin:15px 0 0 12px;padding:0;color:var(--ink,#2c2e2a);font-size:12px;font-weight:700;text-decoration:underline}.ds-contents-crosslink:hover{text-decoration-thickness:2px}@media(prefers-reduced-motion:reduce){.ds-contents a{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Color field",
    "overview": "Color field makes Depositly a cream financial workspace with a substantial apple-green region for income. Dark, tabular figures and open ruled areas carry the information; yellow gives actions and current selections a clear place in the hierarchy. The character is direct, warm, and practical.\n\nThe same materials support two densities: a compact tracker for operating on records and a quieter reading layout for legal documents. Manrope and the supplied Depositly identity connect both. Reuse the broad lower-right curve on important green fields; ordinary controls retain familiar, smaller corners.",
    "keyCharacteristics": [
      "Cream work surfaces and open ruled data.",
      "An apple-green income field with one broad curved corner.",
      "Yellow primary actions and current selections.",
      "Manrope with tabular financial figures.",
      "Responsive stacking with explicit keyboard states."
    ],
    "rules": [
      {
        "name": "The Field and Action Rule",
        "body": "Green establishes an income or principal region; yellow identifies primary actions and current selections. Keep those roles distinct.",
        "section": "colors"
      },
      {
        "name": "The Figure Rule",
        "body": "Financial amounts use tabular figures and stronger scale before extra decoration. Keep currency, amount, and explanatory copy readable as one unit.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Ordinary work surfaces and holding cards are flat. Reserve diffuse shadow and backdrop blur for overlays and transient feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the final redesign stylesheet after the base tracker stylesheet when extending the app.",
      "Do keep Dashboard navigation naming and the supplied Depositly logo, bank artwork, and publisher identity.",
      "Do preserve tabular figures, right-aligned amount columns, and explicit ownership or status text.",
      "Do keep visible focus outlines, semantic controls, and the reduced-motion treatment.",
      "Do stack working areas on phones and allow wide financial tables to scroll inside their container.",
      "Do use the distinct legal reading scale and responsive contents navigation for long documents."
    ],
    "donts": [
      "Don't flatten the entire interface into interchangeable green cards; the implemented hierarchy depends on cream space, rules, and a few substantial green fields.",
      "Don't use yellow for passive surface decoration; it carries action and selection meaning.",
      "Don't scale chart bars independently of their data ratio when the plot height changes.",
      "Don't replace actual account identity, demo identification, or backup state with decorative badges.",
      "Don't treat superseded sidebar styling, Inter typography, decorative eyebrows, or lifted holding cards in the legacy stylesheet as current design rules."
    ]
  }
}
